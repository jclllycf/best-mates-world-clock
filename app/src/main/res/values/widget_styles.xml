<resources>
    <style name="WidgetCitySlot">
        <item name="android:layout_width">130dp</item><item name="android:layout_height">wrap_content</item>
        <item name="android:gravity">center</item><item name="android:orientation">vertical</item>
    </style>
    <style name="WidgetCityIcon">
        <item name="android:layout_width">20dp</item><item name="android:layout_height">20dp</item>
        <item name="android:scaleType">fitCenter</item>
    </style>
    <style name="WidgetCityName">
        <item name="android:layout_width">match_parent</item><item name="android:layout_height">wrap_content</item>
        <item name="android:gravity">center</item><item name="android:ellipsize">end</item><item name="android:maxLines">1</item>
        <item name="android:textColor">#FFFFFFFF</item><item name="android:textSize">11sp</item><item name="android:textStyle">bold</item>
    </style>
    <style name="WidgetCityTime">
        <item name="android:layout_width">wrap_content</item><item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">#FFFFFFFF</item><item name="android:textSize">22sp</item><item name="android:textStyle">bold</item>
        <item name="android:format12Hour">h:mm a</item><item name="android:format24Hour">HH:mm</item>
    </style>
    <style name="WidgetCityDate">
        <item name="android:layout_width">wrap_content</item><item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">#CCFFFFFF</item><item name="android:textSize">9sp</item>
        <item name="android:format12Hour">EEE, MMM d</item><item name="android:format24Hour">EEE, MMM d</item>
    </style>
    <style name="WidgetCustomText">
        <item name="android:layout_width">wrap_content</item><item name="android:layout_height">wrap_content</item>
        <item name="android:scaleType">center</item>
    </style>
</resources>
